{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/sobre-mi/",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?sanchezdevelop\\.com"
        }
      ],
      "destination": "https://kodikadigital.com/sobre-kodika/",
      "permanent": true
    },
    {
      "source": "/sobre-mi",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?sanchezdevelop\\.com"
        }
      ],
      "destination": "https://kodikadigital.com/sobre-kodika/",
      "permanent": true
    },
    {
      "source": "/proyectos/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?sanchezdevelop\\.com"
        }
      ],
      "destination": "https://kodikadigital.com/demos/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?sanchezdevelop\\.com"
        }
      ],
      "destination": "https://kodikadigital.com/:path*",
      "permanent": true
    },
    {
      "source": "/sobre-mi/",
      "destination": "/sobre-kodika/",
      "permanent": true
    },
    {
      "source": "/sobre-mi",
      "destination": "/sobre-kodika/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
