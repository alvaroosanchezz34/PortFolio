# Cabeceras de Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/)

# El alias *.pages.dev de producción es una copia exacta del sitio: que no se indexe.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

/*
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Ficheros del repositorio que se publican pero no son páginas.
/docs/*
  X-Robots-Tag: noindex
/scripts/*
  X-Robots-Tag: noindex
/README.md
  X-Robots-Tag: noindex
/package.json
  X-Robots-Tag: noindex

# Fuentes: si cambian, se renombra el fichero.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/assets/img/*
  Cache-Control: public, max-age=604800
